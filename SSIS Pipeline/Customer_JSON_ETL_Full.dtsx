<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" DTS:ExecutableType="SSIS.Package">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Property DTS:Name="Name">Customer_JSON_ETL</DTS:Property>
  <DTS:Variables>
    <DTS:Variable DTS:Name="FilePath" DTS:DataType="String">C:\applab\SSIS Pipeline\customer_data.json</DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable DTS:ExecutableType="STOCK:Sequence" DTS:Name="Main Sequence">
      <DTS:Executables>
        <DTS:Executable DTS:ExecutableType="STOCK:PipelineTask" DTS:Name="Data Flow Task" />
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
