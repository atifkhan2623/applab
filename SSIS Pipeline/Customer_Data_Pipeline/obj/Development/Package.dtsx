                      dataType="System.String"><![CDATA[#region Namespaces
using System;
using System.IO;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Newtonsoft.Json.Linq;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        string filePath = @"C:\\applab\\SSIS Pipeline\\Customer_Data_Pipeline\\customer_data.json";

        string jsonText = File.ReadAllText(filePath);

        JArray data = JArray.Parse(jsonText);

        foreach (var item in data)
        {
            Output0Buffer.AddRow();

            // STRING assignments (match your output column names EXACTLY)
            Output0Buffer.customerid = item["customer_id"]?.ToString() ?? "";
            Output0Buffer.customername = item["customer_name"]?.ToString() ?? "";
            Output0Buffer.email = item["email"]?.ToString() ?? "";
            Output0Buffer.region = item["region"]?.ToString() ?? "";
            Output0Buffer.joindate = item["join_date"]?.ToString() ?? "";

            // ✅ NOW string (NOT int anymore)
            Output0Buffer.loyaltypoints = item["loyalty_points"]?.ToString() ?? "";
        }
    }
}]]></arrayElement>
